# Server binding
PORT=8080
HOST=0.0.0.0

# Reverse proxy target (leave empty when routing client traffic in forward proxy mode)
TARGET_URL=

# Enable standard HTTP forward proxy & HTTPS CONNECT tunneling (true/false)
# Defaults to true when TARGET_URL is empty
ENABLE_FORWARD_PROXY=true

# Strongly recommended for public VMs: Basic auth credentials for forward proxy clients
PROXY_USERNAME=
PROXY_PASSWORD=

# Block access to cloud instance metadata endpoints (169.254.169.254, metadata.google.internal)
BLOCK_METADATA=true

# Optional CORS Access-Control-Allow-Origin header (e.g. * or https://app.example.com)
CORS_ORIGIN=

# Upstream request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000
